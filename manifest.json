{
  "manifestVersion": 2,
  "id": "token-tracker",
  "name": "Token 用量",
  "version": "6.3.0",
  "minAppVersion": "0.978.0",
  "description": "展示所有 Agent 的 Token 消耗统计，支持按时间、Agent、模型筛选和下钻。",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/usage.read",
    "app/provider.credentials.read",
    "app/agents.read",
    "app/sessions.read",
    "app/media.tasks.read"
  ],
  "contributes": {
    "cards": [
      {
        "id": "token-tracker-dashboard",
        "title": "Token 用量",
        "description": "Agent Token 消耗统计仪表盘",
        "route": "/index.html",
        "realization": "page",
        "siteNavEntry": true,
        "closable": false,
        "face": {
          "image": "assets/face.png"
        }
      }
    ],
    "settings": {
      "title": "Token 用量设置",
      "schema": {
        "type": "object",
        "properties": {
          "scanInterval": {
            "type": "number",
            "default": 60,
            "title": "扫描间隔（秒）"
          },
          "highUsageThreshold": {
            "type": "number",
            "default": 30000,
            "title": "高消耗阈值"
          }
        }
      }
    }
  }
}
