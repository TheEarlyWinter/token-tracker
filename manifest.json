{
  "manifestVersion": 2,
  "id": "token-tracker",
  "name": "Token 用量",
  "version": "6.4.14",
  "minAppVersion": "0.1050.9",
  "description": "展示所有 Agent 的 Token 消耗统计，支持按时间、Agent、模型筛选和下钻。",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/usage.read",
    "app/runtime.execute",
    "app/runtime.network",
    "app/input.status",
    "app/hooks.provider-before-request",
    "app/hooks.observe",
    "app/hooks.messages-post-assistant",
    "app/provider.credentials.read",
    "app/agents.read",
    "app/sessions.read",
    "app/media.tasks.read",
    "app/ui.clipboard-write"
  ],
  "contributes": {
    "ui": {
      "inputStatus": [
        {
          "id": "session-cache",
          "title": "本会话缓存、输出速度与首响",
          "text": "缓存：—　速度：—"
        }
      ]
    },
    "cards": [
      {
        "id": "token-tracker-dashboard",
        "title": "Token 用量",
        "description": "Agent Token 消耗统计仪表盘",
        "route": "/dashboard-v6.4.14.html",
        "realization": "page",
        "siteNavEntry": true,
        "closable": false,
        "face": {
          "image": "assets/face.png"
        }
      }
    ],
    "settings": {
      "title": "Token 用量设置",
      "schema": {
        "type": "object",
        "properties": {
          "scanInterval": {
            "type": "number",
            "default": 60,
            "title": "扫描间隔（秒）"
          },
          "highUsageThreshold": {
            "type": "number",
            "default": 30000,
            "title": "高消耗阈值"
          }
        }
      }
    }
  }
}
